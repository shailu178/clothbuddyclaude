# ─── ClothBuddy Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it's already in .gitignore

# ── Backend (server/.env or root .env) ───────────────────────────────────────

# Your Anthropic API key — get it at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# The URL of your deployed frontend (for CORS whitelist)
# In development this is http://localhost:5173
CLIENT_URL=https://clothbuddy.vercel.app

# Port for the backend server (default 3001)
PORT=3001

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# If your backend is on a different domain, set this
# Leave empty if frontend and backend are on the same domain
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT NOTES:
#
# Vercel (frontend):
#   - Add VITE_API_URL pointing to your Railway/Render backend URL
#   - e.g. VITE_API_URL=https://clothbuddy-api.railway.app
#
# Railway (backend):
#   - Add ANTHROPIC_API_KEY
#   - Add CLIENT_URL pointing to your Vercel frontend URL
#   - Railway auto-sets PORT
#
# One-server deploy (e.g. Render):
#   - Backend serves static files from dist/
#   - Set VITE_API_URL= (empty, same origin)
# ─────────────────────────────────────────────────────────────────────────────
